{
  "name": "graybox-social-lobby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "tsc --noEmit -p tsconfig.edge.json",
    "prepare:livekit": "node scripts/prepare-livekit-deploy.mjs",
    "test:token": "node tests/token.mjs",
    "test:livekit-setup": "node tests/livekit-setup.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tests/browser.mjs",
    "test:multiplayer": "node tests/multiplayer.mjs",
    "test:webcam": "node tests/webcam.mjs",
    "test:chat": "node tests/chat.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.35.0",
    "@supabase/supabase-js": "2.119.0",
    "livekit-client": "2.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "livekit-server-sdk": "2.19.3",
    "supabase": "3.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
